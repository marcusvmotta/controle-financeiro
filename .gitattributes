# Normaliza quebras de linha: o repositório guarda tudo em LF.
* text=auto eol=lf

# Arquivos que precisam de CRLF no Windows
*.sln       text eol=crlf
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# Binários: nunca converter
*.png  binary
*.jpg  binary
*.ico  binary
*.gif  binary
*.woff binary
*.woff2 binary
