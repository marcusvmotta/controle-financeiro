# Copie este arquivo para .env e ajuste os valores.
# O .env está no .gitignore: NUNCA faça commit dele.

# Senha do PostgreSQL usada pelo docker-compose
POSTGRES_PASSWORD=finance_dev

# Chave de assinatura do JWT: 32+ caracteres aleatórios.
# Para gerar uma: openssl rand -base64 48
JWT_KEY=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
